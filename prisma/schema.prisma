generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  SUPER_ADMIN
  SELLER
  BUYER
  MODERATOR
}

enum UserStatus {
  PENDING
  ACTIVE
  SUSPENDED
}

enum ProductStatus {
  DRAFT
  ACTIVE
  PAUSED
  OUT_OF_STOCK
  REJECTED
}

enum OrderStatus {
  PENDING
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

enum WithdrawalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum DisputeStatus {
  OPEN
  IN_REVIEW
  RESOLVED
  REJECTED
}

enum PlanCode {
  FREE
  BASIC
  PRO
}

model User {
  id                 String                @id @default(cuid())
  name               String?
  email              String                @unique
  emailVerified      DateTime?
  image              String?
  passwordHash       String?
  role               UserRole              @default(BUYER)
  status             UserStatus            @default(PENDING)
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt

  shop               Shop?
  sellerSubscriptions SellerSubscription[]
  products           Product[]             @relation("SellerProducts")
  orders             Order[]               @relation("BuyerOrders")
  sellerOrders       Order[]               @relation("SellerOrders")
  reviews            Review[]
  reviewVotes        ReviewVote[]
  wishlist           Wishlist?
  cart               Cart?
  addresses          Address[]
  withdrawals        WithdrawalRequest[]
  disputesOpened     Dispute[]             @relation("OpenedDisputes")
  disputesAgainst    Dispute[]             @relation("AgainstDisputes")
  notifications      Notification[]
  couponUsage        CouponUsage[]

  accounts           Account[]
  sessions           Session[]
}

model Shop {
  id            String   @id @default(cuid())
  sellerId      String   @unique
  name          String
  logoUrl       String?
  bannerUrl     String?
  description   String?
  category      String?
  location      String?
  verifiedAt    DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  seller        User     @relation(fields: [sellerId], references: [id])
}

model SubscriptionPlan {
  id                String     @id @default(cuid())
  code              PlanCode   @unique
  name              String
  monthlyPrice      Decimal    @db.Decimal(10, 2)
  listingLimit      Int
  featuredSlots     Int
  analyticsEnabled  Boolean
  stripePriceId     String?
  subscriptions     SellerSubscription[]
}

model SellerSubscription {
  id                    String     @id @default(cuid())
  sellerId              String
  planId                String
  stripeSubscriptionId  String?    @unique
  startsAt              DateTime
  endsAt                DateTime?
  active                Boolean    @default(true)
  createdAt             DateTime   @default(now())
  updatedAt             DateTime   @updatedAt

  seller                User       @relation(fields: [sellerId], references: [id])
  plan                  SubscriptionPlan @relation(fields: [planId], references: [id])
}

model Product {
  id                String         @id @default(cuid())
  sellerId          String
  categoryId        String?
  slug              String         @unique
  title             String
  description       String
  price             Decimal        @db.Decimal(12, 2)
  discountPrice     Decimal?       @db.Decimal(12, 2)
  stock             Int
  sku               String         @unique
  status            ProductStatus  @default(DRAFT)
  isFeatured        Boolean        @default(false)
  ratingAvg         Float          @default(0)
  ratingsCount      Int            @default(0)
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  seller            User           @relation("SellerProducts", fields: [sellerId], references: [id])
  category          Category?      @relation(fields: [categoryId], references: [id])
  images            ProductImage[]
  attributes        ProductAttribute[]
  orderItems        OrderItem[]
  reviews           Review[]
  cartItems         CartItem[]
  wishlistItems     WishlistItem[]
}

model ProductImage {
  id          String   @id @default(cuid())
  productId   String
  url         String
  sortOrder   Int      @default(0)
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model ProductAttribute {
  id          String   @id @default(cuid())
  productId   String
  name        String
  value       String
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model Category {
  id          String      @id @default(cuid())
  name        String
  slug        String      @unique
  parentId    String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  parent      Category?   @relation("CategoryTree", fields: [parentId], references: [id])
  children    Category[]  @relation("CategoryTree")
  products    Product[]
  coupons     Coupon[]
}

model Cart {
  id          String     @id @default(cuid())
  buyerId     String     @unique
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  buyer       User       @relation(fields: [buyerId], references: [id])
  items       CartItem[]
}

model CartItem {
  id          String   @id @default(cuid())
  cartId      String
  productId   String
  quantity    Int      @default(1)
  cart        Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product     Product  @relation(fields: [productId], references: [id])

  @@unique([cartId, productId])
}

model Order {
  id                    String      @id @default(cuid())
  buyerId               String
  sellerId              String
  status                OrderStatus @default(PENDING)
  subtotal              Decimal     @db.Decimal(12, 2)
  discountAmount        Decimal     @db.Decimal(12, 2)
  platformFeeAmount     Decimal     @db.Decimal(12, 2)
  totalAmount           Decimal     @db.Decimal(12, 2)
  currency              String      @default("UZS")
  stripePaymentIntentId String?
  shippingAddressId     String?
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt

  buyer                 User        @relation("BuyerOrders", fields: [buyerId], references: [id])
  seller                User        @relation("SellerOrders", fields: [sellerId], references: [id])
  shippingAddress       Address?    @relation(fields: [shippingAddressId], references: [id])
  items                 OrderItem[]
  review                Review?
  dispute               Dispute?
}

model OrderItem {
  id             String   @id @default(cuid())
  orderId        String
  productId      String
  quantity       Int
  snapshotTitle  String
  snapshotPrice  Decimal  @db.Decimal(12, 2)

  order          Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product        Product  @relation(fields: [productId], references: [id])
}

model Review {
  id            String       @id @default(cuid())
  buyerId       String
  productId     String
  orderId       String?      @unique
  rating        Int
  content       String
  sellerReply   String?
  createdAt     DateTime     @default(now())

  buyer         User         @relation(fields: [buyerId], references: [id])
  product       Product      @relation(fields: [productId], references: [id])
  order         Order?       @relation(fields: [orderId], references: [id])
  images        ReviewImage[]
  votes         ReviewVote[]
}

model ReviewImage {
  id           String   @id @default(cuid())
  reviewId     String
  url          String
  review       Review   @relation(fields: [reviewId], references: [id], onDelete: Cascade)
}

model ReviewVote {
  id           String   @id @default(cuid())
  reviewId     String
  userId       String
  helpful      Boolean
  review       Review   @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  user         User     @relation(fields: [userId], references: [id])

  @@unique([reviewId, userId])
}

model Wishlist {
  id           String         @id @default(cuid())
  buyerId      String         @unique
  buyer        User           @relation(fields: [buyerId], references: [id])
  items        WishlistItem[]
}

model WishlistItem {
  id           String   @id @default(cuid())
  wishlistId   String
  productId    String
  wishlist     Wishlist @relation(fields: [wishlistId], references: [id], onDelete: Cascade)
  product      Product  @relation(fields: [productId], references: [id])

  @@unique([wishlistId, productId])
}

model Address {
  id            String   @id @default(cuid())
  buyerId       String
  label         String
  fullName      String
  phone         String
  country       String
  city          String
  street        String
  postalCode    String?
  isDefault     Boolean  @default(false)

  buyer         User     @relation(fields: [buyerId], references: [id])
  orders        Order[]
}

model Withdrawal {
  id             String    @id @default(cuid())
  sellerId       String
  totalAmount    Decimal   @db.Decimal(12, 2)
  paidAt         DateTime?
  reference      String?
  notes          String?
}

model WithdrawalRequest {
  id             String           @id @default(cuid())
  sellerId       String
  amount         Decimal          @db.Decimal(12, 2)
  bankAccount    String
  status         WithdrawalStatus @default(PENDING)
  adminNote      String?
  createdAt      DateTime         @default(now())

  seller         User             @relation(fields: [sellerId], references: [id])
}

model Dispute {
  id             String        @id @default(cuid())
  orderId        String        @unique
  openedById     String
  againstUserId  String
  status         DisputeStatus @default(OPEN)
  reason         String
  resolutionNote String?
  createdAt      DateTime      @default(now())

  order          Order         @relation(fields: [orderId], references: [id])
  openedBy       User          @relation("OpenedDisputes", fields: [openedById], references: [id])
  againstUser    User          @relation("AgainstDisputes", fields: [againstUserId], references: [id])
}

model Notification {
  id            String   @id @default(cuid())
  userId        String
  title         String
  body          String
  readAt        DateTime?
  createdAt     DateTime @default(now())

  user          User     @relation(fields: [userId], references: [id])
}

model Coupon {
  id            String      @id @default(cuid())
  code          String      @unique
  categoryId    String?
  type          String
  value         Decimal     @db.Decimal(10, 2)
  usageLimit    Int?
  active        Boolean     @default(true)
  startsAt      DateTime
  endsAt        DateTime

  category      Category?   @relation(fields: [categoryId], references: [id])
  usage         CouponUsage[]
}

model CouponUsage {
  id            String   @id @default(cuid())
  couponId      String
  userId        String
  orderId       String
  usedAt        DateTime @default(now())

  coupon        Coupon   @relation(fields: [couponId], references: [id])
  user          User     @relation(fields: [userId], references: [id])

  @@unique([couponId, userId, orderId])
}

model Account {
  id                 String  @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String? @db.Text
  access_token       String? @db.Text
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String? @db.Text
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id            String   @id @default(cuid())
  sessionToken  String   @unique
  userId        String
  expires       DateTime
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}
